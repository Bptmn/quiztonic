# Flutter/Dart
build/                        # outputs du build
.dart_tool/                   # dossier Dart Tools
.packages                     # ancien fichier de mapping
.pub/                         # cache Pub local
.flutter-plugins              # plugins déclarés
.flutter-plugins-dependencies # dépendances de plugins
pubspec.lock                  # verrouillage des versions (optionnel à commiter selon votre workflow)

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/

# macOS
.DS_Store

# Android
/android/.gradle/
/android/app/build/
/android/gradle/
/android/local.properties    # contient le SDK path local
**/captures/                 # captures de tests
**/externalNativeBuild/
/android/**/generated/       # code auto-généré

# iOS
/ios/Flutter/Flutter.framework/
/ios/Pods/
/ios/Runner.xcworkspace/
/ios/Runner/GeneratedPluginsRegistrant.* # auto-généré
ios/ServiceDefinitions.json
ios/Podfile.lock
**/*.xcuserstate
**/*.xccheckout
**/project.xcworkspace/
**/build/
/*.xcworkspace

# Keystores
*.jks
key.properties

# Optional: logs, coverage, profiling
*.log
coverage/
